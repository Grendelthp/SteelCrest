<script>
async function submitForm(){
  var name=document.getElementById('f_name').value.trim();
  var phone=document.getElementById('f_phone').value.trim();
  var email=document.getElementById('f_email').value.trim();
  var city=document.getElementById('f_city').value.trim();
  var address=document.getElementById('f_address').value.trim();
  var rooftype=document.getElementById('f_rooftype').value;
  var worktype=document.getElementById('f_worktype').value;
  var message=document.getElementById('f_message').value.trim();
  var errEl=document.getElementById('fErr');

  if(!name||!phone||!email||!city||!rooftype||!worktype){
    errEl.textContent='Please fill in all required fields (*).';
    errEl.style.display='block';
    return;
  }
  errEl.style.display='none';
  var btn=document.getElementById('fBtn');
  btn.disabled=true;
  btn.textContent='Sending...';

  try{
    var resp=await fetch('https://formspree.io/f/xdapyekw',{
      method:'POST',
      headers:{'Content-Type':'application/json','Accept':'application/json'},
      body:JSON.stringify({
        name,phone,email,city,
        address:address||'Not provided',
        roof_type:rooftype,
        work_type:worktype,
        message:message||'No comments.',
        source:'Landing Page — contact.html'
      })
    });
    if(resp.ok){
      document.getElementById('fForm').style.display='none';
      document.getElementById('fSuccess').style.display='block';
      trackFormSubmit();
    } else {
      throw new Error('Failed');
    }
  } catch(err){
    errEl.textContent='Failed to send. Please call (437) 223-3414 directly.';
    errEl.style.display='block';
    btn.disabled=false;
    btn.textContent='📨 Send My Free Estimate Request';
  }
}
</script>

</body>
</html>
