<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:wght@300;400;500;600;700&family=Barlow+Condensed:wght@600;700&display=swap" rel="stylesheet">

<style>
:root{
  --steel:#1a1f2e;
  --iron:#2c3347;
  --rust:#c94a1f;
  --rust-light:#e05a28;
  --silver:#8b97a8;
  --chrome:#c8d4e0;
  --white:#f0f4f8;
  --gold:#d4922a;
  --green:#2ecc71;
}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{font-family:'Barlow',sans-serif;background:var(--steel);color:var(--white);min-height:100vh;}

/* TOP BAR */
.topbar{
  background:var(--rust);
  padding:.6rem 2rem;
  display:flex;align-items:center;justify-content:center;gap:2rem;flex-wrap:wrap;
}
.topbar a{
  color:#fff;text-decoration:none;
  font-family:'Barlow Condensed',sans-serif;
  font-size:.9rem;letter-spacing:2px;text-transform:uppercase;font-weight:700;
  display:flex;align-items:center;gap:.4rem;
  transition:opacity .2s;
}
.topbar a:hover{opacity:.85;}

/* NAV */
nav{
  background:rgba(26,31,46,0.97);
  padding:1rem 3rem;
  display:flex;align-items:center;justify-content:space-between;
  border-bottom:2px solid rgba(201,74,31,.4);
}
.logo{font-family:'Bebas Neue',sans-serif;font-size:1.8rem;letter-spacing:3px;color:var(--white);text-decoration:none;}
.logo span{color:var(--rust);}
.nav-back{
  color:var(--silver);text-decoration:none;
  font-size:.8rem;letter-spacing:1.5px;text-transform:uppercase;font-weight:600;
  transition:color .2s;display:flex;align-items:center;gap:.4rem;
}
.nav-back:hover{color:var(--chrome);}

/* HERO STRIP */
.hero-strip{
  background:linear-gradient(135deg,#0d1018 0%,#1a1f2e 60%,#0a0d15 100%);
  padding:3.5rem 3rem 2.5rem;
  text-align:center;
  position:relative;overflow:hidden;
}
.hero-strip::before{
  content:'';position:absolute;inset:0;
  background-image:linear-gradient(rgba(139,151,168,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(139,151,168,.05) 1px,transparent 1px);
  background-size:50px 50px;
}
.hero-strip::after{
  content:'';position:absolute;top:0;right:0;
  width:40%;height:100%;
  background:linear-gradient(135deg,rgba(201,74,31,.12),transparent 70%);
  clip-path:polygon(30% 0%,100% 0%,100% 100%,0% 100%);
}
.hero-strip-inner{position:relative;z-index:2;}
.hs-tag{
  display:inline-block;
  font-family:'Barlow Condensed',sans-serif;
  font-size:.75rem;letter-spacing:4px;text-transform:uppercase;
  color:var(--rust-light);border:1px solid rgba(201,74,31,.4);
  padding:.35rem 1.1rem;border-radius:2px;margin-bottom:1rem;
}
.hero-strip h1{
  font-family:'Bebas Neue',sans-serif;
  font-size:clamp(2.2rem,5vw,4rem);
  letter-spacing:2px;line-height:1;margin-bottom:.8rem;
}
.hero-strip h1 em{font-style:normal;color:var(--rust);}
.hero-strip p{
  color:var(--silver);font-size:.95rem;
  max-width:520px;margin:0 auto 1.5rem;line-height:1.7;
}

/* TRUST PILLS */
.trust-pills{
  display:flex;gap:.6rem;justify-content:center;flex-wrap:wrap;margin-bottom:.5rem;
}
.pill{
  background:rgba(201,74,31,.1);border:1px solid rgba(201,74,31,.25);
  padding:.3rem .9rem;border-radius:2px;
  font-family:'Barlow Condensed',sans-serif;
  font-size:.75rem;letter-spacing:1.5px;text-transform:uppercase;
  color:var(--rust-light);font-weight:700;
}

/* MAIN LAYOUT */
.main{
  display:grid;grid-template-columns:1fr 420px;
  gap:0;max-width:1100px;margin:0 auto;
  padding:2.5rem 2rem 4rem;
}

/* FORM CARD */
.form-card{
  background:var(--iron);
  border:1px solid rgba(201,74,31,.3);
  border-top:4px solid var(--rust);
  border-radius:4px;
  padding:2.5rem;
  position:sticky;top:1.5rem;
  height:fit-content;
  box-shadow:0 20px 60px rgba(0,0,0,.4);
}
.form-card-title{
  font-family:'Bebas Neue',sans-serif;
  font-size:1.9rem;letter-spacing:2px;margin-bottom:.3rem;
}
.form-card-sub{color:var(--silver);font-size:.85rem;margin-bottom:1.8rem;line-height:1.5;}

/* URGENCY BAR */
.urgency{
  background:rgba(212,146,42,.1);border:1px solid rgba(212,146,42,.3);
  padding:.6rem 1rem;border-radius:2px;margin-bottom:1.5rem;
  font-size:.78rem;color:var(--gold);line-height:1.5;
}
.urgency strong{display:block;font-size:.82rem;margin-bottom:.2rem;}

.fg{display:flex;flex-direction:column;gap:.35rem;margin-bottom:.9rem;}
.fg label{font-size:.7rem;letter-spacing:2px;text-transform:uppercase;color:var(--silver);font-weight:600;}
.fg input,.fg select,.fg textarea{
  background:rgba(26,31,46,.8);
  border:1px solid rgba(139,151,168,.2);
  border-radius:2px;color:var(--white);
  padding:.75rem 1rem;font-family:'Barlow',sans-serif;font-size:.9rem;
  transition:border-color .2s;width:100%;
}
.fg input:focus,.fg select:focus,.fg textarea:focus{outline:none;border-color:var(--rust);}
.fg select option{background:var(--steel);}
.fg textarea{resize:vertical;min-height:80px;}
.fg input::placeholder,.fg textarea::placeholder{color:var(--silver);opacity:.5;}
.frow{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;}

.f-err{
  background:rgba(201,74,31,.12);border:1px solid rgba(201,74,31,.35);
  padding:.6rem .9rem;border-radius:2px;color:var(--rust-light);
  font-size:.82rem;margin-bottom:.8rem;display:none;
}
.f-submit{
  width:100%;padding:1rem;
  background:var(--rust);color:var(--white);
  border:none;border-radius:2px;
  font-family:'Barlow',sans-serif;font-size:.9rem;
  letter-spacing:2px;text-transform:uppercase;font-weight:700;
  cursor:pointer;transition:background .2s,transform .15s;
  margin-top:.3rem;
}
.f-submit:hover{background:var(--rust-light);transform:translateY(-1px);}
.f-submit:disabled{background:var(--silver);cursor:not-allowed;transform:none;}

.divider{
  display:flex;align-items:center;gap:.8rem;
  margin:1rem 0;color:var(--silver);font-size:.78rem;
}
.divider::before,.divider::after{content:'';flex:1;height:1px;background:rgba(139,151,168,.2);}

.call-btn{
  display:flex;align-items:center;justify-content:center;gap:.6rem;
  width:100%;padding:.9rem;
  background:rgba(46,204,113,.1);border:1px solid rgba(46,204,113,.3);
  border-radius:2px;color:#2ecc71;
  font-family:'Barlow Condensed',sans-serif;
  font-size:1.1rem;letter-spacing:2px;text-transform:uppercase;font-weight:700;
  text-decoration:none;transition:background .2s,border-color .2s;
}
.call-btn:hover{background:rgba(46,204,113,.2);border-color:rgba(46,204,113,.5);}

.f-success{
  display:none;text-align:center;padding:2rem 0;
}
.f-success .s-icon{font-size:3rem;margin-bottom:1rem;}
.f-success h3{
  font-family:'Bebas Neue',sans-serif;font-size:2rem;
  color:#2ecc71;margin-bottom:.5rem;
}
.f-success p{color:var(--silver);line-height:1.7;font-size:.9rem;}

/* LEFT CONTENT */
.left-col{padding-right:3rem;}

.why-choose{margin-bottom:2.5rem;}
.wc-title{
  font-family:'Bebas Neue',sans-serif;
  font-size:1.8rem;letter-spacing:1px;margin-bottom:1.2rem;
}
.wc-item{
  display:flex;gap:1rem;align-items:flex-start;
  padding:1rem 0;border-bottom:1px solid rgba(139,151,168,.1);
}
.wc-item:last-child{border-bottom:none;}
.wc-icon{
  width:44px;height:44px;flex-shrink:0;
  background:rgba(201,74,31,.12);border:1px solid rgba(201,74,31,.3);
  border-radius:2px;display:grid;place-items:center;font-size:1.2rem;
}
.wc-text h4{font-weight:700;font-size:.95rem;margin-bottom:.25rem;}
.wc-text p{color:var(--silver);font-size:.85rem;line-height:1.6;}

/* REVIEWS */
.reviews-mini{margin-bottom:2.5rem;}
.rm-title{
  font-family:'Bebas Neue',sans-serif;
  font-size:1.4rem;letter-spacing:1px;margin-bottom:1rem;
}
.rm-card{
  background:var(--iron);border-left:3px solid var(--rust);
  padding:1.2rem 1.4rem;margin-bottom:.8rem;border-radius:0 4px 4px 0;
  position:relative;
}
.rm-stars{color:var(--gold);font-size:.8rem;margin-bottom:.5rem;}
.rm-card p{color:var(--chrome);font-size:.85rem;line-height:1.7;margin-bottom:.6rem;}
.rm-author{font-size:.78rem;color:var(--silver);font-weight:600;}

/* STATS STRIP */
.stats-strip{
  display:grid;grid-template-columns:repeat(3,1fr);
  gap:1px;background:rgba(139,151,168,.1);
  border:1px solid rgba(139,151,168,.1);border-radius:4px;
  overflow:hidden;margin-bottom:2.5rem;
}
.ss-item{
  background:var(--iron);padding:1.2rem;text-align:center;
}
.ss-num{
  font-family:'Bebas Neue',sans-serif;
  font-size:2rem;color:var(--rust);line-height:1;
}
.ss-label{font-size:.7rem;letter-spacing:1.5px;text-transform:uppercase;color:var(--silver);margin-top:.2rem;}

/* SERVICES LIST */
.services-list{margin-bottom:2rem;}
.sl-title{font-family:'Bebas Neue',sans-serif;font-size:1.4rem;letter-spacing:1px;margin-bottom:1rem;}
.sl-item{
  display:flex;align-items:center;gap:.7rem;
  padding:.6rem 0;border-bottom:1px solid rgba(139,151,168,.08);
  font-size:.88rem;color:var(--chrome);
}
.sl-item::before{content:'▸';color:var(--rust);font-size:.8rem;}

/* FOOTER */
.lp-footer{
  background:#060810;border-top:1px solid rgba(139,151,168,.1);
  padding:1.5rem 3rem;
  display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;
  font-size:.78rem;color:var(--silver);
}
.lp-footer a{color:var(--silver);text-decoration:none;}
.lp-footer a:hover{color:var(--chrome);}

/* MOBILE STICKY CTA */
.mob-cta{
  display:none;position:fixed;bottom:0;left:0;right:0;z-index:999;
  background:var(--rust);padding:.9rem 1.5rem;
  display:none;align-items:center;justify-content:center;gap:1rem;
}
.mob-cta a{
  color:#fff;text-decoration:none;
  font-family:'Barlow Condensed',sans-serif;
  font-size:1rem;letter-spacing:1.5px;text-transform:uppercase;font-weight:700;
}

@media(max-width:860px){
  .main{grid-template-columns:1fr;padding:1.5rem 1.2rem 6rem;}
  .left-col{padding-right:0;margin-bottom:2rem;order:2;}
  .form-card{position:static;order:1;}
  .frow{grid-template-columns:1fr;}
  nav{padding:.8rem 1.2rem;}
  .hero-strip{padding:2rem 1.2rem 1.5rem;}
  .mob-cta{display:flex;}
  .lp-footer{padding:1.2rem;}
  .stats-strip{grid-template-columns:repeat(3,1fr);}
}
</style>
</head>
