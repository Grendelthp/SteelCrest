function trackFormSubmit(){
  gtag('event','conversion',{
    'send_to':'AW-18066894111/XXXXXXXXX',
    'value':150.0,'currency':'CAD',
    'transaction_id':Date.now()
  });
  gtag('event','generate_lead',{
    'event_category':'form',
    'event_label':'landing_page_estimate',
    'value':150
  });
}
function trackPhoneClick(){
  gtag('event','conversion',{'send_to':'AW-18066894111/XXXXXXXXX'});
